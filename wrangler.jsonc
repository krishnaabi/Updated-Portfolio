{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "updated-portfolio",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".env*",
      "functions/**",
      "supabase/**",
      "server.js",
      "package.json",
      "package-lock.json",
      "wrangler.jsonc",
      "*.md"
    ]
  }
}
